---
import Layout from '../layouts/Layout.astro';
import { getAllArticles } from '../lib/microcms';
import { formatDate } from '../lib/utils';

// ビルド時に 1 回だけ実行される（閲覧時には実行されない）
const articles = await getAllArticles({ fields: 'id,title,description,thumbnail,tags,publishedAt,createdAt' });
---

<Layout>
  {articles.length === 0 && <p>記事がありません。</p>}
  <ul class="list">
    {
      articles.map((article) => (
        <li>
          <a href={`/articles/${article.id}/`}>
            {article.thumbnail && (
              <img src={`${article.thumbnail.url}?fm=webp&fit=crop&w=240&h=126`} alt="" width="240" height="126" />
            )}
            <div>
              <h2>{article.title}</h2>
              <p>{article.tags.map((tag) => <span class="tag">#{tag.name}</span>)}</p>
              <p class="date">{formatDate(article.publishedAt ?? article.createdAt)}</p>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>

<style>
  .list {
    list-style: none;
    padding: 0;
  }
  .list li {
    border-bottom: 1px solid #eee;
  }
  .list a {
    display: flex;
    gap: 16px;
    padding: 16px 0;
    color: inherit;
    text-decoration: none;
  }
  .list h2 {
    font-size: 1.125rem;
    margin: 0 0 4px;
  }
  .list p {
    margin: 0;
  }
</style>
